{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "dialog:allow-confirm",
    "fs:allow-write-text-file",
    "core:window:allow-start-dragging",
    "process:allow-exit"
  ]
}
